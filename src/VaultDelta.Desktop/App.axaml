<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VaultDelta.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, PingFang SC, Microsoft YaHei UI, sans-serif" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#F3F1EC" />
            <Setter Property="Foreground" Value="#17211F" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#087C6A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#066B5C" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#23302D" />
            <Setter Property="BorderBrush" Value="#D7DAD4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C6C2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#263C38" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#D8F3EB" />
            <Setter Property="Foreground" Value="#075F52" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D8F3EB" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DEE0DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="0 6 22 0 #120E1816" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#087C6A" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17211F" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#68736F" />
        </Style>
        <Style Selector="Button.filter">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#F4F5F1" />
            <Setter Property="BorderBrush" Value="#DCE0DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.filter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8F3EF" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="#F7F8F4" />
            <Setter Property="BorderBrush" Value="#E0E2DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Application.Styles>
</Application>
