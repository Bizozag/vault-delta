<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VaultDelta.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="780"
        x:Class="VaultDelta.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Vault Delta"
        Width="1280"
        Height="780"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="*,34" Background="#F3F1EC">
        <Grid Grid.Row="0" ColumnDefinitions="84,*">
            <Border Grid.Column="0" Background="#172B27">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,18,0,14">
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="7">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1DAA91">
                            <Path Width="24"
                                  Height="24"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Data="M3,6 L10,6 L10,3 L15,8 L10,13 L10,10 L3,10 Z M21,14 L14,14 L14,11 L9,16 L14,21 L14,18 L21,18 Z" />
                        </Border>
                        <TextBlock Text="VD" FontSize="12" FontWeight="Bold" LetterSpacing="1.5" Foreground="#DCE9E5" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="LOCAL" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.4" Foreground="#759089" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="106,*">
                <Border Grid.Row="0" Background="#FAF9F6" BorderBrush="#DDDFDA" BorderThickness="0,0,0,1" Padding="28,17,28,15">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="VAULT DELTA" Classes="eyebrow" />
                            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#17211F" />
                            <TextBlock Text="{Binding PageDescription}" Classes="muted" FontSize="12" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="360" Height="58" Padding="4" CornerRadius="15" Background="#E7E9E5" BorderBrush="#D5D9D3" BorderThickness="1" VerticalAlignment="Center">
                            <Grid Width="352">
                                <Border Width="176" Height="48" HorizontalAlignment="Left" CornerRadius="11" Background="White" BoxShadow="0 3 10 0 #1F17211F">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="{Binding SwitchIndicatorOffset}">
                                            <TranslateTransform.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="X" Duration="0:0:0.20" />
                                                </Transitions>
                                            </TranslateTransform.Transitions>
                                        </TranslateTransform>
                                    </Border.RenderTransform>
                                </Border>
                                <Grid ColumnDefinitions="*,*">
                                    <Button x:Name="CompareNavigation" Grid.Column="0" Classes="mode" Classes.active="{Binding IsCompareSelected}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Compare" AutomationProperties.Name="创建更新包">
                                        <StackPanel Spacing="1"><TextBlock Text="创建更新包" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="比较并打包变化" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="PatchesNavigation" Grid.Column="1" Classes="mode" Classes.active="{Binding IsPatchesSelected}"
                                            Command="{Binding NavigateCommand}" CommandParameter="Patches" AutomationProperties.Name="应用更新包">
                                        <StackPanel Spacing="1"><TextBlock Text="应用更新包" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="检查、应用与恢复" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ComparePage" IsVisible="{Binding IsCompareSelected}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,26,34,42" Spacing="18" DataContext="{Binding Compare}">
                            <Border x:Name="AdvancedScopePanel" Classes="card" Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#E7F2EF">
                                            <TextBlock Text="◎" Foreground="#087C6A" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="同步范围" FontWeight="SemiBold" FontSize="15" />
                                                <Border Background="#F0F2EE" CornerRadius="9" Padding="7,2"><TextBlock Text="高级" Classes="muted" FontSize="10" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="使用可复用配置，只比较库中的指定子目录；配置不绑定任何电脑。" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                        <Button x:Name="ToggleScopePanelButton" Grid.Column="2" Content="{Binding $parent[Window].DataContext.ScopePanelButtonText}" Classes="secondary"
                                                Command="{Binding $parent[Window].DataContext.ToggleScopePanelCommand}" MinHeight="34" Padding="12,5" />
                                    </Grid>

                                    <Border x:Name="AdvancedScopeContent" IsVisible="{Binding $parent[Window].DataContext.IsScopePanelExpanded}" CornerRadius="10" Background="#F7F8F4" BorderBrush="#E0E2DC" BorderThickness="1" Padding="15">
                                        <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="18">
                                            <StackPanel Grid.Column="0" Spacing="9">
                                                <TextBlock Text="本次比较范围" FontWeight="SemiBold" />
                                                <ComboBox SelectedIndex="0" IsEnabled="False">
                                                    <ComboBoxItem Content="全部文件（当前默认）" />
                                                    <ComboBoxItem Content="工作资料 · B / C / D" />
                                                </ComboBox>
                                                <TextBlock Text="配置文件将只保存名称、相对目录和范围版本；本机路径与基线单独记录。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="9" Background="#172D28" Padding="14">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="16">
                                                    <StackPanel Spacing="3"><TextBlock Text="B" Foreground="#F5C98E" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="首次完整装入" Foreground="White" FontSize="11"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="C + D" Foreground="#65D3B8" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="沿用本机基线" Foreground="White" FontSize="11"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right"><TextBlock Text="规划中" Foreground="#AFC8C1" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="本版不改变实际范围" Foreground="#AFC8C1" FontSize="10"/></StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="22">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="COMPARE" Classes="eyebrow" />
                                            <TextBlock Text="选择两个独立快照" Classes="sectionTitle" FontSize="20" />
                                            <TextBlock Text="扫描只读取文件。两个目录不能相同，也不能互相包含。" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#EAF3F0" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#075F52" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,26,*" ColumnSpacing="8">
                                        <Border Grid.Column="0" x:Name="BaselineDropZone" Padding="14" CornerRadius="10" Background="#F7F8F4" BorderBrush="#DDE0DA" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <TextBlock Text="01  旧快照 / 基线 · 可拖入文件夹" FontSize="12" FontWeight="SemiBold" Foreground="#53605C" />
                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBox Text="{Binding BaselinePath}" PlaceholderText="拖入或选择原始 Obsidian 文件夹" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" />
                                                    <Button Grid.Column="1" x:Name="SelectBaselineButton" Content="选择…" Classes="secondary" Command="{Binding SelectBaselineCommand}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#87928E" />
                                        <Border Grid.Column="2" x:Name="TargetDropZone" Padding="14" CornerRadius="10" Background="#F7F8F4" BorderBrush="#DDE0DA" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <TextBlock Text="02  新快照 / 目标 · 可拖入文件夹" FontSize="12" FontWeight="SemiBold" Foreground="#53605C" />
                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBox Text="{Binding TargetPath}" PlaceholderText="拖入或选择更新后的 Obsidian 文件夹" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" />
                                                    <Button Grid.Column="1" x:Name="SelectTargetButton" Content="选择…" Classes="secondary" Command="{Binding SelectTargetCommand}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Text="当前比较全部文件；路径与文件系统安全检查始终启用" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" x:Name="CancelCompareButton" Content="取消" Classes="secondary" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                                        <Button Grid.Column="2" x:Name="StartCompareButton" Content="开始比较" Classes="primary" Command="{Binding CompareCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ScanningPanel" Classes="card" Padding="22" IsVisible="{Binding IsComparing}">
                                <Grid ColumnDefinitions="*,220" ColumnSpacing="28">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding StatusText}" Classes="sectionTitle" />
                                        <ProgressBar IsIndeterminate="True" Height="7" />
                                        <TextBlock Text="{Binding CurrentPath}" Classes="muted" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="已处理条目" Classes="muted" FontSize="11" />
                                        <TextBlock Text="{Binding ProcessedEntries}" FontSize="28" FontWeight="SemiBold" Foreground="#087C6A" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="CompareErrorPanel" Classes="card" Padding="20" IsVisible="{Binding IsError}" BorderBrush="#E7BDA1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="无法完成比较" FontWeight="SemiBold" Foreground="#934A24" />
                                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="muted" />
                                    <TextBlock Text="已保留目录选择，可直接调整后重试。" Classes="muted" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="CompareEmptyPanel" Classes="card" Padding="24" IsVisible="{Binding IsEmptyState}">
                                <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="差异审核区" Classes="sectionTitle" />
                                        <TextBlock Text="比较完成后，这里会列出新增、修改、删除和重命名。筛选只改变显示，不会改变底层差异结果。" Classes="muted" TextWrapping="Wrap" LineHeight="20" />
                                        <TextBlock Text="生成更新包将在审核完成后的下一阶段开放。" Foreground="#087C6A" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="10" Background="#172D28" Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="风险项会自动标记" Foreground="#E1EFEB" FontWeight="SemiBold" />
                                            <TextBlock Text="删除 · 重命名&#x0a;Obsidian 配置&#x0a;同路径类型变化" Foreground="#94AAA4" FontSize="12" LineHeight="21" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="CompareResultPanel" Spacing="14" IsVisible="{Binding HasResult}">
                                <Grid ColumnDefinitions="*,*,*,*,1.35*,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Classes="metric"><StackPanel><TextBlock Text="{Binding AddedCount}" FontSize="22" FontWeight="SemiBold" Foreground="#087C6A"/><TextBlock Text="新增" Classes="muted" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="1" Classes="metric"><StackPanel><TextBlock Text="{Binding ModifiedCount}" FontSize="22" FontWeight="SemiBold" Foreground="#356A8A"/><TextBlock Text="修改" Classes="muted" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="2" Classes="metric"><StackPanel><TextBlock Text="{Binding DeletedCount}" FontSize="22" FontWeight="SemiBold" Foreground="#A45C23"/><TextBlock Text="删除" Classes="muted" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="3" Classes="metric"><StackPanel><TextBlock Text="{Binding RenamedCount}" FontSize="22" FontWeight="SemiBold" Foreground="#6A568F"/><TextBlock Text="重命名" Classes="muted" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="4" Classes="metric"><StackPanel><TextBlock Text="{Binding TransferSizeText}" FontSize="15" FontWeight="SemiBold" Foreground="#17211F"/><TextBlock Text="预计传输" Classes="muted" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="5" Classes="metric"><StackPanel><TextBlock Text="{Binding RiskCount}" FontSize="22" FontWeight="SemiBold" Foreground="#9A4D32"/><TextBlock Text="风险项" Classes="muted" FontSize="11"/></StackPanel></Border>
                                </Grid>

                                <Border Classes="card" Padding="18">
                                    <StackPanel Spacing="13">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="审核变化" Classes="sectionTitle" />
                                                <TextBlock Text="仅显示变化项；未变化条目仍保留在完整比较结果中。" Classes="muted" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="全部" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="All" />
                                                <Button Content="新增" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="Added" />
                                                <Button Content="修改" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="Modified" />
                                                <Button Content="删除" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="Deleted" />
                                                <Button Content="重命名" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="Renamed" />
                                                <Button Content="风险项" Classes="filter" Command="{Binding SetFilterCommand}" CommandParameter="Risks" />
                                            </StackPanel>
                                        </Grid>

                                        <Border IsVisible="{Binding HasNoChanges}" Padding="24" CornerRadius="10" Background="#EDF6F2">
                                            <TextBlock Text="两个快照内容一致，无需生成更新包。" HorizontalAlignment="Center" Foreground="#075F52" FontWeight="SemiBold" />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding FilteredEntries}" IsVisible="{Binding HasChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DiffReviewItemViewModel">
                                                    <Border Padding="12,10" Margin="0,0,0,7" CornerRadius="8" Background="#F8F8F5" BorderBrush="#E2E3DE" BorderThickness="1">
                                                        <Grid ColumnDefinitions="82,*,Auto" ColumnSpacing="12">
                                                            <Border Background="#E7F2EE" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold" Foreground="#075F52" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding RiskText}" IsVisible="{Binding HasRisk}" Foreground="#A45C23" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="下一步将把审核结果交给更新包生成 Gate。" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding PatchBuildStatusText}" Classes="muted" FontSize="11" VerticalAlignment="Center" MaxWidth="330" TextTrimming="CharacterEllipsis" />
                                                <Button x:Name="BuildPatchButton" Content="生成 ZIP 更新包" Classes="primary" Command="{Binding BuildPatchCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PatchesPage" IsVisible="{Binding IsPatchesSelected}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,26,34,42" Spacing="16" DataContext="{Binding Patches}">
                            <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="16">
                                <Border Grid.Column="0" Classes="card" Padding="22">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="APPLY GATE" Classes="eyebrow" />
                                                <TextBlock Text="检查并应用更新包" Classes="sectionTitle" FontSize="20" />
                                                <TextBlock Text="先验证 ZIP、载荷和目标基线。只有 Gate 全部通过后才允许写入。" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#E8F3EF" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Foreground="#075F52" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <Border x:Name="PatchPackageDropZone" Padding="10" CornerRadius="10" Background="#F7F8F4" BorderBrush="#C9D8D3" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox Text="{Binding PackagePath}" IsReadOnly="True" PlaceholderText="拖入 .zip 更新包，或点击打开" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" />
                                                <Button Grid.Column="1" x:Name="OpenPatchButton" Content="打开更新包" Classes="primary" Command="{Binding OpenPatchCommand}" />
                                            </Grid>
                                        </Border>

                                        <Border IsVisible="{Binding ShowPackageSummary}" CornerRadius="10" Background="#F6F7F3" BorderBrush="#DEE1DB" BorderThickness="1" Padding="14">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5">
                                                <TextBlock Text="{Binding PatchId}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding OperationCount, StringFormat={}{0} 项操作}" Classes="muted" FontSize="11" />
                                                <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Classes="muted" FontSize="11" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PayloadText}" Classes="muted" FontSize="11" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="PatchTargetDropZone" Padding="10" CornerRadius="10" Background="#F7F8F4" BorderBrush="#C9D8D3" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <TextBox Text="{Binding TargetPath}" IsReadOnly="True" PlaceholderText="拖入目标库文件夹，或点击选择" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" />
                                                <Button Grid.Column="1" Content="选择目标库" Classes="secondary" Command="{Binding SelectTargetCommand}" />
                                                <Button Grid.Column="2" x:Name="ValidateBaselineButton" Content="检查基线" Classes="secondary" Command="{Binding ValidateCommand}" />
                                            </Grid>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="写入前会验证文件系统能力，并为覆盖和删除项建立独立备份。" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="ApplyPatchButton" Content="应用更新包" Classes="primary" Command="{Binding ApplyCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card" Padding="22">
                                    <StackPanel Spacing="15">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RECOVERY" Classes="eyebrow" Foreground="#A45C23" />
                                            <TextBlock Text="事务恢复" Classes="sectionTitle" FontSize="20" />
                                            <TextBlock Text="恢复只需要 Journal 与同目录备份，不依赖原更新包；中断后可使用同一 Journal 重试。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBox Text="{Binding JournalPath}" IsReadOnly="True" PlaceholderText="尚未选择 journal.json" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" />
                                            <Button Grid.Column="1" Content="打开 Journal" Classes="secondary" Command="{Binding OpenJournalCommand}" />
                                        </Grid>
                                        <Border Background="#FFF4E9" BorderBrush="#EAC9AA" BorderThickness="1" CornerRadius="9" Padding="12">
                                            <TextBlock Text="恢复会反向执行已完成操作，并逐项校验目标是否回到基线。" Foreground="#8A512B" FontSize="11" TextWrapping="Wrap" />
                                        </Border>
                                        <Button x:Name="RollbackButton" Content="开始恢复" Classes="secondary" HorizontalAlignment="Left" Command="{Binding RollbackCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="ConflictPanel" Classes="card" Padding="20" IsVisible="{Binding ShowConflictPanel}" BorderBrush="#E4B691">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="基线冲突：目标库尚未被修改" FontWeight="SemiBold" Foreground="#934A24" />
                                        <TextBlock Text="请确认选中了正确的旧版本库，或先处理以下文件差异。" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Conflicts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BaselineConflictItemViewModel">
                                                <Grid ColumnDefinitions="130,*,1.2*" ColumnSpacing="12" Margin="0,3">
                                                    <TextBlock Text="{Binding TypeText}" Foreground="#A45C23" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PatchErrorPanel" Classes="card" Padding="18" IsVisible="{Binding IsError}" BorderBrush="#E2AAA0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="操作未完成" Foreground="#9B4335" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ErrorMessage}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ApplyResultPanel" Classes="card" Padding="20" IsVisible="{Binding ShowApplyResult}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#DDF2EA"><TextBlock Text="✓" Foreground="#087C6A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                        <TextBlock Text="备份和 Journal 已保留；如需撤销，可直接使用右侧恢复入口。" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="NeedsRollbackPanel" Classes="card" Padding="20" IsVisible="{Binding ShowNeedsRollback}" BorderBrush="#E3AE83">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#FFF0E2"><TextBlock Text="!" Foreground="#A45C23" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="应用中断，需要恢复" FontWeight="SemiBold" Foreground="#934A24" />
                                        <TextBlock Text="{Binding ErrorMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="Journal 已自动填入右侧恢复入口；恢复不依赖原更新包。" Foreground="#A45C23" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="RollbackResultPanel" Classes="card" Padding="20" IsVisible="{Binding ShowRollbackResult}">
                                <TextBlock Text="恢复完成，所有可逆操作已逐项校验。" Foreground="#075F52" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="PatchBuildProgressPanel"
                            ZIndex="10"
                            DataContext="{Binding Compare}"
                            IsVisible="{Binding IsGeneratingPatch}"
                            Width="580"
                            Margin="34,0,34,24"
                            Padding="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            CornerRadius="12"
                            Background="#172D28"
                            BorderBrush="#2D544B"
                            BorderThickness="1"
                            BoxShadow="0 8 24 0 #52000000">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding PatchBuildProgressText}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PatchBuildProgressPercentage, StringFormat={}{0}%}" Foreground="#65D3B8" FontSize="20" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding PatchBuildProgressPercentage}" Height="8" />
                            <TextBlock Grid.Row="2" Text="{Binding PatchBuildCurrentPath}" Foreground="#AFC8C1" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#E9E8E3" BorderBrush="#D5D6D1" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="所有操作均在本机完成" FontSize="11" Foreground="#7A837F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11" Foreground="#7A837F" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
